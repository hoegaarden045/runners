[Unit]
Description=GitLab Runner Docker Compose project
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/runner
ExecStart=/usr/bin/docker compose -f /opt/runner/compose.yaml up -d
ExecReload=/usr/bin/docker compose -f /opt/runner/compose.yaml up -d
ExecStop=/usr/bin/docker compose -f /opt/runner/compose.yaml stop
TimeoutStartSec=300
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
